* {
    bg: #002b36;
    bg-alt: #073642;
    fg: #eee8d5;
    selection: #268bd2;
    accent: #d33682;
    
    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font Mono 11";
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @selection;
    border-radius: 10px;
    width: 500px;
    padding: 15px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 6px;
    padding: 8px 12px;
    children: [ entry ];
}

entry {
    placeholder: "Search...";
    placeholder-color: #93a1a1;
    text-color: @fg;
}

listview {
    lines: 10;
    columns: 2;
    fixed-height: false;
    spacing: 4px;
}

element {
    padding: 8px 12px;
    border-radius: 6px;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color: #002b36;
}

element-text {
    text-color: inherit;
}

element-icon {
    size: 32px;
    vertical-align: 0.5;
}
