# Core Configuration
font=JetBrainsMono Nerd Font Mono 10
width=350
height=110
margin=10
padding=12
border-size=2
border-radius=8
default-timeout=5000
group-by=summary

# Colors (Solarized Dark Palette)
background-color=#002b36
text-color=#eee8d5
border-color=#268bd2
progress-color=over #073642

# Icons (Papirus Dark)
icons=1
max-icon-size=48
icon-path=/home/leto/.local/share/icons/Papirus-Solarized:/usr/share/icons/Papirus-Dark:/usr/share/icons/Papirus

[urgency=low]
border-color=#586e75
default-timeout=3000

[urgency=normal]
border-color=#268bd2
default-timeout=5000

[urgency=critical]
border-color=#dc322f
text-color=#ff8073
default-timeout=0
